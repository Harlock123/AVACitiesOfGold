<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AVACitiesOfGold</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Sound: OpenAL Soft mixes every effect (the same audio layer as AVABand and AVAWizardry). -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Sounds\**\*" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\**" />
    <None Remove="Audio\native\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVACitiesOfGold.Tests" />
  </ItemGroup>
</Project>
